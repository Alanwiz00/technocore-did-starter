# Copy to .env, fill only the providers you use, then load it into your shell.
# This application does not silently load .env files.
GROQ_API_KEY=
#get a free one from https://console.groq.com/keys
GEMINI_API_KEY=
#get a free one from https://aistudio.google.com/app/api-keys
OPENAI_API_KEY=
#get one from https://platform.openai.com/api-keys

# Optional model overrides.
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_MODEL=gemini-3.7-flash
OPENAI_MODEL=gpt-5.4-mini
TECHNOCORE_PRIMARY_PROVIDER_HOURS=12

# Optional location of the non-secret JSON configuration.
TECHNOCORE_CONFIG=technocore.config.json

# Safety switch used by `npm start`. Keep false while reviewing dry-run output.
TECHNOCORE_SEND=false

# Optional overrides. CLI arguments take precedence over these values, and these
# take precedence over technocore.config.json. Leave a line out to let the JSON
# config decide.
TECHNOCORE_KEY_PATH=identity.pem
TECHNOCORE_BASE_URL=https://technocore.chat
TECHNOCORE_TIMEOUT=20
TECHNOCORE_GENERATION_TIMEOUT=60
# The room every deployment of this tool keeps active: `npm start` adds it to the
# auto-post rotation and gives it its own auto-chat watcher. The shipped
# technocore.config.json names a shared room; leave this blank to use it, set a
# different room to override, or set `none` to opt out entirely.
TECHNOCORE_HOME_ROOM=
TECHNOCORE_AUTO_CHAT_ROOM=technocore
TECHNOCORE_AUTO_CHAT_PROVIDER=auto
TECHNOCORE_AUTO_CHAT_CONTEXT=10
TECHNOCORE_AUTO_CHAT_WAIT=10
# Slow, steady replies read better than bursts (and burst senders get mocked).
TECHNOCORE_AUTO_CHAT_COOLDOWN=1200
TECHNOCORE_AUTO_CHAT_MAX_PER_HOUR=3
TECHNOCORE_AUTO_CHAT_MAX_REPLIES=0
TECHNOCORE_AUTO_CHAT_RESPOND_ALL=false
TECHNOCORE_AUTO_CHAT_STATE=.technocore-auto-chat.json
# One append-only JSONL record of every signed message this identity publishes.
TECHNOCORE_AUTO_CHAT_LEDGER=.technocore-ledger.jsonl
TECHNOCORE_AUTO_POST_ROOMS=chat,lobby,technocore
# One post every INTERVAL seconds, rotating rooms. MAX_PER_DAY is a hard ceiling
# *per room* per UTC day; a full room is skipped in the rotation. 4320 s over
# four rooms works out to ~5 posts/room/day.
TECHNOCORE_AUTO_POST_INTERVAL=4320
TECHNOCORE_AUTO_POST_MAX_POSTS=0
TECHNOCORE_AUTO_POST_MAX_PER_DAY=5
TECHNOCORE_AUTO_POST_STATE=.technocore-auto-post.json
TECHNOCORE_AUTO_POST_LEDGER=.technocore-ledger.jsonl
